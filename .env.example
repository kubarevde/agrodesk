# Frontend (Vite) — copy/adapt for local or CI builds.
# Dev tip: leave VITE_API_URL empty to use Vite proxy (`/api` → backend).

VITE_API_URL=http://localhost:8000
VITE_APP_NAME=АгроДеск
VITE_USE_MOCKS=false

# Optional production static base path (subfolder deploy)
# VITE_BASE_PATH=/

# Maps (Leaflet). Default basemap is satellite (Esri World Imagery, no key).
# For production quotas / MapTiler Satellite, set VITE_MAP_SATELLITE_URL with your key
# and matching attribution. OSM schema layer remains available in the layer switcher.
# VITE_MAP_DEFAULT_BASEMAP=satellite
# VITE_MAP_SATELLITE_URL=https://api.maptiler.com/maps/satellite/{z}/{x}/{y}.jpg?key=YOUR_KEY
# VITE_MAP_SATELLITE_ATTRIBUTION=© MapTiler © OpenStreetMap contributors
# VITE_MAP_TILES_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_TILES_ATTRIBUTION=© OpenStreetMap contributors
